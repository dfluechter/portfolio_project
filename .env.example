# =============================================================================
# Portfolio Project - Environment Configuration Template
# =============================================================================
# Kopiere diese Datei nach '.env' und passe die Werte für deine lokale Umgebung an.
# ACHTUNG: Sensitive Zugangsdaten niemals in Git committen!
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Django Core & Portfolio-Inhaber
# -----------------------------------------------------------------------------
# Debug-Modus (in Produktion immer False)
DEBUG=True

# Django Secret Key für Session- und JWT-Signierung
SECRET_KEY=lokaler_super_sicherer_schluessel_fuer_die_entwicklung_123

# Inhaber-Informationen (Wichtig für Impressum & Password-Reset-Routing)
PORTFOLIO_OWNER_NAME="Dominik Flüchter"
PORTFOLIO_OWNER_EMAIL=replace-me@example.com

# Frontend-Domain für Djoser-Passwort-Reset-Links und E-Mail-Templates (ohne https://)
FRONTEND_DOMAIN=localhost:3000
SITE_NAME="Dominik Flüchter Portfolio"

# Netzsicherheit: Erlaubte Hosts & Origins
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173


# -----------------------------------------------------------------------------
# 2. E-Mail / SMTP (Passwort-Reset & Systembenachrichtigungen)
# -----------------------------------------------------------------------------
# Lokal standardmäßig Console-Backend (Mails erscheinen im Terminal)
# In Produktion: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-me@example.com
EMAIL_HOST_PASSWORD=replace-me-app-password
DEFAULT_FROM_EMAIL="Dominik Flüchter <webmaster@localhost>"


# -----------------------------------------------------------------------------
# 3. Datenbank (Neon PostgreSQL / Lokales SQLite)
# -----------------------------------------------------------------------------
# Lokal auskommentiert lassen, falls SQLite (db.sqlite3) verwendet werden soll.
# Auf Render werden DATABASE_URL (Pooled, PgBouncer) für Webserver-Worker
# und DIRECT_DATABASE_URL (Direct Connection) für DDL-Migrationen genutzt.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL=postgresql://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require


# -----------------------------------------------------------------------------
# 4. Supabase S3 Media Storage (django-storages)
# -----------------------------------------------------------------------------
# Schalter: True aktiviert Supabase S3 Storage; False nutzt lokales Dateisystem (media/)
USE_SUPABASE_S3=False

# S3 API Credentials (Supabase Dashboard -> Project Settings -> Storage -> S3 Credentials)
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_STORAGE_BUCKET_NAME=portfolio-media
AWS_S3_ENDPOINT_URL=https://<project-ref>.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=eu-central-1

# Öffentlicher Zugriff auf Media-Assets
AWS_S3_PUBLIC_BUCKET=True
SUPABASE_PUBLIC_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/portfolio-media


# -----------------------------------------------------------------------------
# 5. Google Gemini AI (RAG, Copilot & Zero-Cost Token-Schutz)
# -----------------------------------------------------------------------------
# API-Key für Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Globale KI-Aktivierung
GEMINI_AI_ENABLED=True

# Multimodale Verarbeitung von Zertifikaten (Bilder/PDFs)
GEMINI_VISION_ENABLED=True
GEMINI_VISION_MAX_FILE_BYTES=10485760  # 10 MB Sicherheitsgrenze

# Zero-Cost Schutzschalter (Circuit-Breaker): Schaltet KI bei Überschreitung ab
DAILY_TOKEN_LIMIT=50000
GEMINI_DAILY_TOKEN_LIMIT=50000
MAX_DAILY_AI_REQUESTS=100
GEMINI_DAILY_REQUEST_LIMIT=100
GEMINI_MAX_INPUT_TOKENS=4000


# -----------------------------------------------------------------------------
# 6. Lokale Zertifikate-Pfade (Management-Commands & Synchronisation)
# -----------------------------------------------------------------------------
# ACHTUNG: CERTIFICATES_PATH ist STRIKT SCHREIBGESCHÜTZT (READ-ONLY)!
# Niemals Dateien in diesem Ordner ändern, überschreiben, verschieben oder löschen.
CERTIFICATES_PATH=/pfad/zu/deinen/archivierten/zertifikaten
CERTIFICATES_INBOX_PATH=/pfad/zu/neuen/zertifikaten
